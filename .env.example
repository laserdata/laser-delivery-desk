# Local Laser Stack (docker compose up -d)
LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
# LaserData Cloud instead: user:password@your-deployment.laserdata.cloud (or token@host)

# The stream; deleted and created again at startup and on New day
DESK_STREAM=delivery-desk
# 1 keeps the stream at startup instead of starting a new day
DESK_KEEP=0
# Vans at startup, 2 to 8 (the Vans slider changes it on a running server)
DESK_VANS=4
# Drops each van starts with, and the new orders that come in during the day
DESK_JOBS=6
DESK_ORDERS=10
DESK_ORDER_FIRST=15
DESK_ORDER_EVERY=8
# Customer memory's stream; New day leaves it alone
DESK_MEMORY_STREAM=delivery-desk-memory

# LLM: mock (default), claude (claude -p) or api (needs ANTHROPIC_API_KEY)
DESK_LLM=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Seconds routing holds before committing a new round, so you can kill it (0 = off)
DESK_STEP_PAUSE=0
# Seconds before an approval decides itself (0 = wait for a person)
DESK_AUTO_DECIDE=0

# The demo loop: 1 starts it with the server
DESK_DEMO=0
DESK_DEMO_PAUSE=10
DESK_DEMO_APPROVE_DELAY=4

# The chaos monkey: 1 starts it with the server
DESK_CHAOS=0
DESK_CHAOS_AGENTS=dispatch,routing,routing-2,customer,invoice
DESK_CHAOS_MIN=3
DESK_CHAOS_MAX=10

# The simulator
DESK_TICK=0.5
DESK_SPEED=120
DESK_DWELL=4

# Traces: set to 0 to turn off
DESK_OTEL=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DESK_PORT=8000
